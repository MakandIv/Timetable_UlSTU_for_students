                        android:maxWidth="250dp"
                        android:padding="5dp"
                        android:textAlignment="center"
                        android:textStyle="bold" />
                </TableRow>

                <TableRow
                    android:id="@+id/para5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/para5num"
                        android:layout_width="20dp"
                        android:layout_height="80dp"
                        android:padding="5dp"
                        android:text="5"
                        android:textAlignment="center"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/para5time"
                        android:layout_width="60dp"
                        android:layout_height="80dp"
                        android:padding="5dp"
                        android:text="@string/time5"
                        android:textAlignment="center"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/para5text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:maxWidth="250dp"
                        android:padding="5dp"
                        android:textAlignment="center"
                        android:textStyle="bold" />

                </TableRow>

                <TableRow
                    android:id="@+id/para6"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/para6num"
                        android:layout_width="20dp"
                        android:layout_height="80dp"
                        android:padding="5dp"
                        android:text="6"
                        android:textAlignment="center"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/para6time"
                        android:layout_width="60dp"
                        android:layout_height="80dp"
                        android:padding="5dp"
                        android:text="@string/time6"
                        android:textAlignment="center"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/para6text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:maxWidth="250dp"
                        android:padding="5dp"
                        android:textAlignment="center"
                        android:textStyle="bold" />

                </TableRow>

                <TableRow
                    android:id="@+id/para7"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/para7num"
                        android:layout_width="20dp"
                        android:layout_height="80dp"
                        android:padding="5dp"
                        android:text="7"
                        android:textAlignment="center"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/para7time"
                        android:layout_width="60dp"
                        android:layout_height="80dp"
                        android:padding="5dp"
                        android:text="@string/time7"
                        android:textAlignment="center"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/para7text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:maxWidth="250dp"
                        android:padding="5dp"
                        android:textAlignment="center"
                        android:textStyle="bold" />

                </TableRow>

                <TableRow
                    android:id="@+id/para8"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/para8num"
                        android:layout_width="20dp"
                        android:layout_height="80dp"
                        android:padding="5dp"
                        android:text="8"
                        android:textAlignment="center"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/para8time"
                        android:layout_width="60dp"
                        android:layout_height="80dp"
