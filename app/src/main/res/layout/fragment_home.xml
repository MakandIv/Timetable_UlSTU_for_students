                        android:maxWidth="250dp"
                        android:padding="5dp"
                        android:textAlignment="center"
                        android:textStyle="bold" />

                </TableRow>
            </TableLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>